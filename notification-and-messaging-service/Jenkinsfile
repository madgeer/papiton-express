pipeline {
    agent any

    environment {
        SERVICE_NAME = 'notification-service'
        DOCKER_IMAGE = 'papiton/notification-service'
        DOCKER_REG   = 'registry.papiton.id'
        GOPATH       = '/root/go'
        GONOSUMDB    = '*'
        GONOPROXY    = '*'
        GOFLAGS      = '-mod=mod'
        PATH         = "/root/go/bin:/usr/local/go/bin:${env.PATH}"
    }

    stages {

        // ── Stage 1: Checkout ─────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                sh 'go version'
                echo "Branch: ${env.GIT_BRANCH} | Build: ${env.BUILD_NUMBER}"
            }
        }

        // ── Stage 2: Unit Tests ───────────────────────────────────────────────
        stage('Unit Tests') {
            steps {
                sh '''
                    export PATH=/root/go/bin:/usr/local/go/bin:$PATH
                    export GONOSUMDB='*'
                    export GONOPROXY='*'
                    export GOFLAGS='-mod=mod'

                    # go mod tidy untuk pastikan go.sum lengkap
                    go mod tidy

                    # Install mockgen dari go.uber.org/mock (sesuai go.mod baru)
                    # Paksa install ulang agar versinya sesuai
                    GONOSUMDB='*' GONOPROXY='*' go install go.uber.org/mock/mockgen@v0.5.0

                    # Generate mock lalu jalankan test
                    make generate-mocks
                    make test-unit
                '''
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing:          true,
                        alwaysLinkToLastBuild: true,
                        keepAll:               true,
                        reportDir:             '.',
                        reportFiles:           'coverage.html',
                        reportName:            'Coverage Report - Notification Service'
                    ])
                }
            }
        }

        // ── Stage 3: Lint / Vet ───────────────────────────────────────────────
        stage('Lint / Vet') {
            steps {
                sh '''
                    export PATH=/root/go/bin:/usr/local/go/bin:$PATH
                    make lint
                '''
            }
        }

        // ── Stage 4: Build Docker Image ───────────────────────────────────────
        stage('Build Image') {
            steps {
                sh """
                    docker build \\
                        -t ${DOCKER_REG}/${DOCKER_IMAGE}:${BUILD_NUMBER} \\
                        -t ${DOCKER_REG}/${DOCKER_IMAGE}:latest \\
                        .
                """
            }
        }

        // ── Stage 5: Functional Tests ─────────────────────────────────────────
        stage('Functional Tests') {
            steps {
                sh '''
                    export PATH=/root/go/bin:/usr/local/go/bin:$PATH
                    make test-functional
                '''
            }
            post {
                always {
                    sh 'docker-compose -f docker-compose-test.yml down || true'
                }
            }
        }

        // ── Stage 6: Push Image (hanya di branch master/main) ─────────────────
        stage('Push Image') {
            when {
                anyOf {
                    branch 'master'
                    branch 'main'
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'docker-registry-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh """
                        echo \$DOCKER_PASS | docker login ${DOCKER_REG} -u \$DOCKER_USER --password-stdin
                        docker push ${DOCKER_REG}/${DOCKER_IMAGE}:${BUILD_NUMBER}
                        docker push ${DOCKER_REG}/${DOCKER_IMAGE}:latest
                    """
                }
            }
        }

        // ── Stage 7: Deploy ke Kubernetes ─────────────────────────────────────
        stage('Deploy to Kubernetes') {
            when {
                anyOf {
                    branch 'master'
                    branch 'main'
                }
            }
            steps {
                sh """
                    kubectl set image deployment/${SERVICE_NAME} \\
                        ${SERVICE_NAME}=${DOCKER_REG}/${DOCKER_IMAGE}:${BUILD_NUMBER} \\
                        --namespace=papiton-prod
                """
            }
        }

        // ── Stage 8: Verify Deployment ────────────────────────────────────────
        stage('Verify Deployment') {
            when {
                anyOf {
                    branch 'master'
                    branch 'main'
                }
            }
            steps {
                sh """
                    kubectl rollout status deployment/${SERVICE_NAME} \\
                        --namespace=papiton-prod \\
                        --timeout=120s
                """
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline berhasil! Image: ${DOCKER_REG}/${DOCKER_IMAGE}:${BUILD_NUMBER}"
        }
        failure {
            echo "❌ Pipeline gagal! Cek log di atas untuk detail error."
        }
        cleanup {
            sh "docker rmi ${DOCKER_REG}/${DOCKER_IMAGE}:${BUILD_NUMBER} || true"
            sh "docker rmi ${DOCKER_REG}/${DOCKER_IMAGE}:latest || true"
        }
    }
}
